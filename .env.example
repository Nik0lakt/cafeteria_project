# ─── Required secrets ───────────────────────────────────────────────
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=replace_with_a_random_64_character_secret

# Generate: python -c "import bcrypt; print(bcrypt.hashpw(b'your_password', bcrypt.gensalt()).decode())"
ADMIN_PASSWORD_HASH=replace_with_a_real_bcrypt_hash

# ─── Database ───────────────────────────────────────────────────────
# These values are consumed by docker-compose. Do not use the example password in production.
POSTGRES_USER=cafeteria_app
POSTGRES_PASSWORD=replace_with_a_long_random_database_password
POSTGRES_DB=cafeteria_db
DATABASE_URL=postgresql://cafeteria_app:replace_with_a_long_random_database_password@db:5432/cafeteria_db

# ─── Telegram Bot (optional) ─────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
ADMIN_CHAT_ID=

# ─── Face Recognition ───────────────────────────────────────────────
FACE_RECOGNITION_TOLERANCE=0.55
PRIVATE_PHOTOS_DIR=/app/data/private_photos

# ─── Browser security ───────────────────────────────────────────────
# Comma-separated allowlist. Do not use * in production.
CORS_ORIGINS=https://your.domain.com
