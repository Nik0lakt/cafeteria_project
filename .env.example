# ─── Required ───────────────────────────────────────────────────────
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change_me_to_a_long_random_secret_key_min_32_chars

# Generate: python -c "import bcrypt; print(bcrypt.hashpw(b'your_password', bcrypt.gensalt()).decode())"
ADMIN_PASSWORD_HASH=$2b$12$replacethiswitharealhashedpassword

# ─── Database ──────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@db:5432/cafeteria_db
POSTGRES_USER=user
POSTGRES_PASSWORD=change-me-in-production
POSTGRES_DB=cafeteria_db

# ─── Telegram Bot (optional) ───────────────────────────────────────
TELEGRAM_BOT_TOKEN=
ADMIN_CHAT_ID=

# ─── Face Recognition ─────────────────────────────────────────────
FACE_RECOGNITION_TOLERANCE=0.55

# ─── CORS (comma-separated origins) ───────────────────────────────
CORS_ORIGINS=http://localhost:3000,http://localhost:8000
